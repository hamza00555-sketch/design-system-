# Firebase web app config — Project settings → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where the API lives. It is part of this site, so this is the site's own
# address — https://your-site.vercel.app in production, http://localhost:3000
# in development.
NEXT_PUBLIC_MISWADAH_API_BASE=

# How the API writes to Firestore: the whole service-account JSON, on one line.
# Firebase console → Project settings → Service accounts → Generate new private
# key. A secret — never give it a NEXT_PUBLIC_ prefix.
FIREBASE_SERVICE_ACCOUNT=

# Only for local development against the emulators; leave unset in production.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_PROJECT_ID=demo-miswadah

# Set to 1 to point the app at the local Firebase emulators.
NEXT_PUBLIC_FIREBASE_EMULATORS=

# Set to 1 to turn on plans, limits, and the Stripe upgrade path. Leave unset
# and the product is simply open: unlimited projects, teammates, generations.
# Must match BILLING_ENABLED on the functions side.
NEXT_PUBLIC_BILLING_ENABLED=

# Set to 1 to put the marketing landing page in front of the app. Unset, the
# root goes straight to the dashboard — the right default for a private
# instance.
NEXT_PUBLIC_PUBLIC_SITE=
