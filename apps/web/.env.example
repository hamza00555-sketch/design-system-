# Firebase web app config — Project settings → Your apps → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Base URL of the Cloud Function (`api`). Locally:
#   http://127.0.0.1:5001/<project-id>/us-central1/api
NEXT_PUBLIC_TOKENWELL_API_BASE=

# Set to 1 to point the app at the local Firebase emulators.
NEXT_PUBLIC_FIREBASE_EMULATORS=
