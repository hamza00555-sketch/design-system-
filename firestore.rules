rules_version = '2';

// Reads are scoped to the caller's team. Every write goes through Cloud
// Functions with the Admin SDK — API keys, versions, and connect codes are
// never writable from a browser.
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(teamId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/teams/$(teamId)/members/$(request.auth.uid));
    }

    match /teams/{teamId} {
      allow read: if isMember(teamId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(teamId);
        allow write: if false;
      }
    }

    match /systems/{systemId} {
      allow read: if isMember(resource.data.teamId);
      allow write: if false;

      match /versions/{versionId} {
        allow read: if isMember(
          get(/databases/$(database)/documents/systems/$(systemId)).data.teamId
        );
        allow write: if false;
      }
    }

    match /projects/{projectId} {
      allow read: if isMember(resource.data.teamId);
      allow write: if false;
    }

    // A team can see its own outstanding invitations. The invitee does not read
    // this collection at all — they hand their token to the accept endpoint,
    // which is also why the token is never exposed to a client.
    match /invites/{inviteId} {
      allow read: if isMember(resource.data.teamId);
      allow write: if false;
    }

    match /verifications/{verificationId} {
      allow read: if isMember(resource.data.teamId);
      allow write: if false;
    }

    // Secrets: server-side only, never readable by a client.
    match /projectKeys/{hash} {
      allow read, write: if false;
    }

    match /connectCodes/{code} {
      allow read, write: if false;
    }

    match /stripeEvents/{eventId} {
      allow read, write: if false;
    }
  }
}
