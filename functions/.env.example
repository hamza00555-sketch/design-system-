# Non-secret function config (functions/.env — safe to commit if you want).
STRIPE_PRICE_ID=price_...
APP_URL=https://your-app-url

# Secrets. For a real deployment they live in Secret Manager:
#   firebase functions:secrets:set STRIPE_SECRET_KEY
#   firebase functions:secrets:set STRIPE_WEBHOOK_SECRET
#
# For the emulators, put them in functions/.env.local — that is the file the
# emulator actually loads. (.secret.local is documented for secrets but is not
# picked up here, which costs an afternoon if you don't know.)
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...

# Who may claim a workspace. Unset, the first person to sign in claims the
# instance and everyone after them needs an invitation.
# ALLOWED_EMAILS=you@example.com,you@work.com
# OPEN_SIGNUPS=1        # run this as a public product instead
